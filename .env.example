# Copy to .env and fill in. Every value is optional — a missing key only
# disables the MCP server that needs it; the rest of BountyReper still runs.

# --- Repo location -----------------------------------------------------------
# MCP servers are referenced relative to the repo root. Only set this if you
# launch your agent from outside the repo (otherwise leave it unset).
# BOUNTYREPER_ROOT=/absolute/path/to/bounty-reper

# --- Caido MCP ---------------------------------------------------------------
# Personal Access Token from Caido -> Settings -> Authentication.
# Requires Caido running locally.
CAIDO_URL=http://127.0.0.1:8080
CAIDO_PAT=

# --- Model provider ----------------------------------------------------------
# Only needed to run the standalone hackbrowser crawler outside BountyReper.
# The integrated `hackbrowser` tool uses BountyReper's configured provider.
# ANTHROPIC_API_KEY=
