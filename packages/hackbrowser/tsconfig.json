{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    // Mirror bountyreaper's tsconfig settings — required because we import bountyreaper source directly
    "types": ["bun"],
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@/*": ["../bountyreaper/src/*"],
      "@tui/*": ["../bountyreaper/src/cli/cmd/tui/*"]
    }
  },
  "exclude": ["test-cases"]
}
